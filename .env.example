#copy me to .env and fill in real values. .env is gitignored, this template is not.
#(real environment variables beat .env if both exist)

#discord developer portal -> your application -> bot -> reset token
BOT_TOKEN=paste-the-bot-token-here

#discord settings -> advanced -> developer mode on, then right-click the server -> copy server id
GUILD_TOKEN=123456789012345678

#optional: the dyno/carl logging channel mined by /backfill_nicknames.
#defaults to the built-in one, only set this to override it
#LOG_CHANNEL=1404266860937216082
